# Copy this file to .env before running `docker compose up -d`.
# Pin a release tag in production so upgrades and rollbacks are deliberate.
OUTPACE_IMAGE=ghcr.io/jamezrin/outpace:0.1.0

# Host-side listener exposure. HTTP and RTMP default to loopback; peer traffic is public.
OUTPACE_HTTP_HOST=127.0.0.1
OUTPACE_HTTP_PORT=6878
OUTPACE_RTMP_HOST=127.0.0.1
OUTPACE_RTMP_PORT=1935

# Normal mode is a full P2P participant. Set both values to 0 for a pure leecher.
OUTPACE_ENABLE_INBOUND=1
OUTPACE_ENABLE_SEEDING=1

# Keep this off in normal bridge-mode Compose. See docs/deployment.md before enabling it.
OUTPACE_ENABLE_PORT_MAPPING=0

# `memory` is the safe default. For ephemeral disk-backed pieces, set `disk`.
OUTPACE_CACHE_TYPE=memory
OUTPACE_CACHE_DIR=/var/lib/outpace/cache
OUTPACE_SEED_STORE_BYTES=134217728

# Supported Ace HTTP subset; opt in with 1, or explicitly disable with 0.
# Accepts exactly 1/true/0/false. Restart/recreate the service after changing it.
# Deprecated OUTPACE_EXPERIMENTAL_ACE_COMPAT is used only when this variable is unset.
# A present canonical value wins, including 0; empty/invalid selected values fail startup.
OUTPACE_ACE_COMPAT=0

# Raw-hash BEP-9 content-id fallback is off by default (live and VOD).
# Opt in on the receiving daemon/standalone play process for another daemon's broadcast
# Ace link. Own broadcasts resolve locally without it; transport URLs are an alternative.
# If using Compose, also pass this variable into the container's environment explicitly.
# OUTPACE_BEP9_CONTENT_ID_FALLBACK=0

# Managed HTTP(S) MPEG-TS startup declarations. URLs may contain query secrets; protect this
# file/environment and avoid configuration dumps. An explicitly empty map value is invalid.
OUTPACE_BROADCAST_SOURCES={}
# Only exact 1 enables private/loopback/CGNAT/ULA source addresses; metadata/link-local stays
# blocked. Independent of transport/tracker opt-ins. See docs/native-api.md for limits.
OUTPACE_ALLOW_NON_GLOBAL_BROADCAST_SOURCE=0
