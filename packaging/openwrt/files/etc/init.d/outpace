#!/bin/sh /etc/rc.common
# procd service for Outpace. Settings: /etc/config/outpace (UCI).
# shellcheck shell=ash disable=SC2034,SC3043

START=99
STOP=10
USE_PROCD=1
PROG=/usr/bin/outpace

append_env() {
	procd_append_param env "$1"
}

append_setting() {
	local option="$1" variable="$2" value
	config_get value main "$option"
	[ -n "$value" ] && procd_append_param env "$variable=$value"
}

start_service() {
	local enabled data_dir
	config_load outpace
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || {
		echo "outpace: disabled; set 'uci set outpace.main.enabled=1 && uci commit outpace'" >&2
		return 0
	}
	config_get data_dir main data_dir /etc/outpace
	mkdir -p "$data_dir"
	chown outpace:outpace "$data_dir" 2>/dev/null
	chmod 0700 "$data_dir"

	procd_open_instance
	procd_set_param command "$PROG" serve
	procd_set_param env OUTPACE_DATA_DIR="$data_dir"
	append_setting bind OUTPACE_BIND
	append_setting rtmp_bind OUTPACE_RTMP_BIND
	append_setting cache_type OUTPACE_CACHE_TYPE
	append_setting cache_dir OUTPACE_CACHE_DIR
	append_setting seed_store_bytes OUTPACE_SEED_STORE_BYTES
	append_setting prebuffer_bytes OUTPACE_PREBUFFER_BYTES
	append_setting session_buffer OUTPACE_SESSION_BUFFER
	append_setting max_sessions OUTPACE_MAX_SESSIONS
	config_list_foreach main env append_env
	# Run unprivileged when the installer created the outpace account.
	if grep -q '^outpace:' /etc/passwd; then
		procd_set_param user outpace
		procd_set_param group outpace
	fi
	procd_set_param stdout 1
	procd_set_param stderr 1
	# procd sends SIGTERM first; give the graceful drain time before SIGKILL.
	procd_set_param term_timeout 30
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger outpace
}
